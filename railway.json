{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "LD_LIBRARY_PATH=/root/.nix-profile/lib cd site/api && gunicorn app:app -b 0.0.0.0:$PORT --log-file -",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/api/health"
  }
}
