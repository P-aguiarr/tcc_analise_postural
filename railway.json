{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "LD_LIBRARY_PATH=/nix/var/nix/profiles/default/lib cd site/api && python app.py",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/api/health"
  }
}
