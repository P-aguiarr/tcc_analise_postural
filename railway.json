{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "LD_LIBRARY_PATH=${pkgs.libGL}/lib:${pkgs.mesa}/lib:${pkgs.opencv}/lib:${pkgs.ffmpeg}/lib:${pkgs.stdenv.cc.lib}/lib:${pkgs.glib}/lib python site/api/app.py",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/api/health"
  }
}
