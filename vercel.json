{
  "version": 2,
  "builds": [
    {
      "src": "site/api/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "site/api/auth/callback.js",
      "use": "@vercel/node"
    },
    {
      "src": "site/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/login.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/poslogin.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/review_new.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/nova_analise.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/historico.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/configuracoes.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/consulta.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/style.css",
      "use": "@vercel/static"
    },
    {
      "src": "site/img/**/*",
      "use": "@vercel/static"
    }
  ],
  "functions": {
    "site/api/app.py": {
      "runtime": "python3.11",
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "site/api/**"
    },
    "site/api/auth/callback.js": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/api/process-analysis",
      "dest": "/site/api/app.py",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/api/analysis/(.*)",
      "dest": "/site/api/app.py",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/videos/(.*)",
      "dest": "/site/api/app.py",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/health",
      "dest": "/site/api/app.py",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/debug/info",
      "dest": "/site/api/app.py",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/auth/callback",
      "dest": "/site/api/auth/callback.js"
    },
    {
      "src": "/",
      "dest": "/site/index.html"
    },
    {
      "src": "/login",
      "dest": "/site/login.html"
    },
    {
      "src": "/poslogin",
      "dest": "/site/poslogin.html"
    },
    {
      "src": "/review_new",
      "dest": "/site/review_new.html"
    },
    {
      "src": "/nova-analise",
      "dest": "/site/nova_analise.html"
    },
    {
      "src": "/historico",
      "dest": "/site/historico.html"
    },
    {
      "src": "/configuracoes",
      "dest": "/site/configuracoes.html"
    },
    {
      "src": "/consulta",
      "dest": "/site/consulta.html"
    },
    {
      "src": "/style.css",
      "dest": "/site/style.css"
    },
    {
      "src": "/img/(.*)",
      "dest": "/site/img/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/site/index.html"
    }
  ],
  "env": {
    "PYTHONPATH": "/var/task/site/api"
  }
}
