{
  "version": 2,
  "builds": [
    {
      "src": "site/api/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "site/api/health.js",
      "use": "@vercel/node"
    },
    {
      "src": "site/api/auth/callback.js",
      "use": "@vercel/node"
    },
    {
      "src": "site/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "site/img/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/site/api/health.js"
    },
    {
      "src": "/api/process-analysis",
      "dest": "/site/api/app.py"
    },
    {
      "src": "/api/analysis/(.*)",
      "dest": "/site/api/app.py"
    },
    {
      "src": "/api/auth/callback",
      "dest": "/site/api/auth/callback.js"
    },
    {
      "src": "/",
      "dest": "/site/index.html"
    },
    {
      "src": "/login",
      "dest": "/site/login.html"
    },
    {
      "src": "/poslogin", 
      "dest": "/site/poslogin.html"
    },
    {
      "src": "/review_new",
      "dest": "/site/review_new.html"
    },
    {
      "src": "/nova-analise",
      "dest": "/site/nova_analise.html"
    },
    {
      "src": "/historico",
      "dest": "/site/historico.html"
    },
    {
      "src": "/configuracoes",
      "dest": "/site/configuracoes.html"
    },
    {
      "src": "/consulta",
      "dest": "/site/consulta.html"
    },
    {
      "src": "/style.css",
      "dest": "/site/style.css"
    },
    {
      "src": "/img/(.*)",
      "dest": "/site/img/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/site/index.html"
    }
  ]
}
