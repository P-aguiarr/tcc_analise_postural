{
  "version": 2,
  "builds": [
    {
      "src": "site/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "site/**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "site/img/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/config",
      "dest": "https://tccanalisepostural-production.up.railway.app/config"
    },
    {
      "src": "/auth/callback",
      "dest": "https://tccanalisepostural-production.up.railway.app/auth/callback"
    },
    {
      "src": "/analyze",
      "dest": "https://tccanalisepostural-production.up.railway.app/analyze"
    },
    {
      "src": "/ping",
      "dest": "https://tccanalisepostural-production.up.railway.app/ping"
    },
    {
      "src": "/analysis/(.*)",
      "dest": "https://tccanalisepostural-production.up.railway.app/analysis/$1"
    },
    {
      "src": "/",
      "dest": "/site/login.html"
    },
    {
      "src": "/login",
      "dest": "/site/login.html"
    },
    {
      "src": "/poslogin",
      "dest": "/site/poslogin.html"
    },
    {
      "src": "/review_new",
      "dest": "/site/review_new.html"
    },
    {
      "src": "/nova-analise",
      "dest": "/site/nova_analise.html"
    },
    {
      "src": "/historico",
      "dest": "/site/historico.html"
    },
    {
      "src": "/configuracoes",
      "dest": "/site/configuracoes.html"
    },
    {
      "src": "/consulta",
      "dest": "/site/consulta.html"
    },
    {
      "src": "/(.*\\.(css|js|html|png|jpg|jpeg|gif|ico))",
      "dest": "/site/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/site/login.html"
    }
  ]
}
