{
  "version": 2,
  "builds": [
    {
      "src": "site/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/login.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/poslogin.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/review_new.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/nova-analise.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/historico.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/api/auth/callback.js",  
      "use": "@vercel/node"
    },
    {
      "src": "site/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "site/img/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/auth/callback",  
      "dest": "/site/api/auth/callback.js"
    },
    {
      "src": "/(.*).css",
      "dest": "/site/$1.css"
    },
    {
      "src": "/img/(.*)",
      "dest": "/site/img/$1"
    },
    {
      "src": "/",
      "dest": "/site/index.html"
    },
    {
      "src": "/login",
      "dest": "/site/login.html"
    },
    {
      "src": "/poslogin",
      "dest": "/site/poslogin.html"
    },
    {
      "src": "/review_new",
      "dest": "/site/review_new.html"
    },
    {
      "src": "/nova-analise",
      "dest": "/site/nova-analise.html"
    },
    {
      "src": "/historico",
      "dest": "/site/historico.html"
    },
    {
      "src": "/(.*)",
      "dest": "/site/index.html"
    }
  ]
}
