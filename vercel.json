{
  "rewrites": [
    { "source": "/", "destination": "/site/index.html" },
    { "source": "/review", "destination": "/site/review.html" },
    { "source": "/(.*)", "destination": "/site/index.html" }
  ],
  "functions": {
    "site/api/auth/callback.js": {
      "includeFiles": "site/api/**/*.js"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/site/api/(.*)", 
      "dest": "/site/api/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      }
    }
  ]
}
