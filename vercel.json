{
  "version": 2,
  "builds": [
    {
      "src": "site/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "site/**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "site/**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "site/img/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    
    <!-- ============================================== -->
    <!-- REWRITES PARA O BACKEND NO RAILWAY (APIs)      -->
    <!-- SUBSTITUA 'YOUR_RAILWAY_URL' PELA SUA URL REAL -->
    <!-- Ex: https://tccanalisepostural-production.up.railway.app -->
    <!-- ============================================== -->
    {
      "src": "/config",
      "dest": "https://YOUR_RAILWAY_URL/config"
    },
    {
      "src": "/auth/callback",
      "dest": "https://YOUR_RAILWAY_URL/auth/callback"
    },
    {
      "src": "/analyze",
      "dest": "https://YOUR_RAILWAY_URL/analyze"
    },
    {
      "src": "/ping",
      "dest": "https://YOUR_RAILWAY_URL/ping"
    },
    {
      "src": "/analysis/(.*)",
      "dest": "https://YOUR_RAILWAY_URL/analysis/$1"
    },
    
    <!-- ============================================== -->
    <!-- ROTAS ESTÁTICAS (MANTIDAS) -->
    <!-- ============================================== -->
    {
      "src": "/",
      "dest": "/site/login.html"
    },
    {
      "src": "/login",
      "dest": "/site/login.html"
    },
    {
      "src": "/poslogin",
      "dest": "/site/poslogin.html"
    },
    {
      "src": "/review_new",
      "dest": "/site/review_new.html"
    },
    {
      "src": "/nova-analise",
      "dest": "/site/nova_analise.html"
    },
    {
      "src": "/historico",
      "dest": "/site/historico.html"
    },
    {
      "src": "/configuracoes",
      "dest": "/site/configuracoes.html"
    },
    {
      "src": "/consulta",
      "dest": "/site/consulta.html"
    },
    {
      "src": "/(.*\\.(css|js|html|png|jpg|jpeg|gif|ico))",
      "dest": "/site/$1"
    },
    
    <!-- Rota de fallback para SPA (Single Page Application) ou erros -->
    {
      "src": "/(.*)",
      "dest": "/site/login.html"
    }
  ]
}
